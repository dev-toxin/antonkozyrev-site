---
// «Now» page prototype (nownownow.com convention). Facts only from the notebook as of 2026-11-13;
// the owner confirms the wording before it goes live.
import LabShell from './LabShell.astro';
import type { Lang } from '../../content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const en = lang === 'en';
const updated = '2026-11-13';
const t = en
  ? {
      title: 'Now — Anton Kozyrev',
      h1: 'Now',
      lead: 'What I am focused on this month. Updated when something changes, not on a schedule.',
      blocks: [
        { k: 'Shipped', items: ['localfrostdates.com — frost dates for 2,088 US weather stations, built by my Go + LLM engine sitefarm (live since 2026-10-29)', 'terroir-app.com — the site of my wine assistant, EN/RU'] },
        { k: 'Building', items: ['TapReply — AI-drafted replies to customer reviews: preparing a pilot with the first venues', 'A new Flutter app for contractors at my current job'] },
        { k: 'Learning', items: ['Python for LLM work — first project: an MCP server over my own notes', 'React + TypeScript, next on the list for the Terroir web app'] },
      ],
      note: 'Prototype for the design session: wording to be confirmed by Anton.',
    }
  : {
      title: 'Сейчас — Антон Козырев',
      h1: 'Сейчас',
      lead: 'Чем занят в этом месяце. Обновляю, когда что-то меняется, а не по расписанию.',
      blocks: [
        { k: 'Выпустил', items: ['localfrostdates.com — даты заморозков для 2 088 метеостанций США, собран моим движком sitefarm на Go и LLM (работает с 2026-10-29)', 'terroir-app.com — сайт моего винного ассистента, EN/RU'] },
        { k: 'Делаю', items: ['TapReply — ИИ-черновики ответов на отзывы: готовлю пилот с первыми заведениями', 'Новое Flutter-приложение для исполнителей на основной работе'] },
        { k: 'Учу', items: ['Python для LLM — первый проект: MCP-сервер к собственным заметкам', 'React + TypeScript, следующий на очереди — для веб-кабинета Terroir'] },
      ],
      note: 'Прототип для сессии дизайна: формулировки подтверждает Антон.',
    };
---

<LabShell lang={lang} title={t.title}>
  <p class="eyebrow"><span class="dot" aria-hidden="true"></span>{en ? 'Updated' : 'Обновлено'} {updated}</p>
  <h1>{t.h1}</h1>
  <p class="lead">{t.lead}</p>
  <p class="lab-note">{t.note}</p>
  <div class="now">
    {t.blocks.map((b) => (
      <section class="now-row">
        <h2>{b.k}</h2>
        <ul>{b.items.map((i) => <li>{i}</li>)}</ul>
      </section>
    ))}
  </div>
</LabShell>

<style is:global>
  .now { border-top: 1px solid var(--line); }
  .now-row { display: grid; grid-template-columns: 12rem 1fr; gap: 2rem; padding: 2rem 0; border-bottom: 1px solid var(--line); }
  .now-row h2 { font-size: 1rem; color: var(--muted); font-weight: 700; letter-spacing: 0; }
  .now-row ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .9rem; }
  .now-row li { font-size: 1.12rem; color: var(--text); line-height: 1.5; }
  @media (max-width: 640px) { .now-row { grid-template-columns: 1fr; gap: .6rem; } }
</style>
