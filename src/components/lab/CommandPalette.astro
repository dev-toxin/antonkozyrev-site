---
// ⌘K / Ctrl+K command palette — prototype for the design session 2026-11-13.
// No framework: a native <dialog> plus ~60 lines of JS. Commands come from site data only.
import { copy, links, type Lang } from '../../content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang];
const en = lang === 'en';
const home = t.path;
const items = [
  { group: en ? 'Jump to' : 'Перейти', label: t.casesTitle, hint: '#work', href: `${home}#work` },
  { group: en ? 'Jump to' : 'Перейти', label: t.appsTitle, hint: '#apps', href: `${home}#apps` },
  { group: en ? 'Jump to' : 'Перейти', label: t.help.title, hint: '#help', href: `${home}#help` },
  { group: en ? 'Jump to' : 'Перейти', label: t.aiTitle, hint: '#ai', href: `${home}#ai` },
  { group: en ? 'Jump to' : 'Перейти', label: t.stackTitle, hint: '#stack', href: `${home}#stack` },
  ...t.cases.map((c) => ({ group: en ? 'Projects' : 'Проекты', label: c.title, hint: c.tag, href: `${home}#${c.id}` })),
  { group: en ? 'Contact' : 'Связаться', label: t.hero.ctaResume, hint: 'PDF', href: t.hero.resumePdf },
  { group: en ? 'Contact' : 'Связаться', label: 'Telegram', hint: '@tokc_a', href: links.telegram },
  { group: en ? 'Contact' : 'Связаться', label: 'Email', hint: links.email, href: `mailto:${links.email}` },
  { group: en ? 'Contact' : 'Связаться', label: 'GitHub', hint: 'dev-toxin', href: links.github },
  { group: en ? 'Site' : 'Сайт', label: t.switchTitle, hint: t.switchLabel, href: en ? '/ru/lab/' : '/lab/' },
  { group: en ? 'Site' : 'Сайт', label: en ? 'Now — what I am working on' : 'Сейчас — над чем работаю', hint: '/now', href: en ? '/lab/now/' : '/ru/lab/now/' },
];
const ui = en
  ? { open: 'Search', placeholder: 'Type a command or search…', empty: 'Nothing found', nav: '↑↓ to move · ↵ to open · esc to close' }
  : { open: 'Поиск', placeholder: 'Команда или поиск…', empty: 'Ничего не найдено', nav: '↑↓ выбор · ↵ открыть · esc закрыть' };
---

<button class="kbar-open" type="button" data-kbar-open aria-haspopup="dialog">
  <span>{ui.open}</span><kbd><span data-kbar-mod>⌘</span>K</kbd>
</button>

<dialog class="kbar" data-kbar aria-label={ui.placeholder}>
  <div class="kbar-box">
    <input class="kbar-input" type="text" placeholder={ui.placeholder} autocomplete="off" spellcheck="false"
      role="combobox" aria-expanded="true" aria-controls="kbar-list" aria-autocomplete="list" data-kbar-input />
    <ul class="kbar-list" id="kbar-list" role="listbox" data-kbar-list>
      {items.map((it, i) => (
        <li role="option" id={`kbar-${i}`} data-group={it.group} data-text={`${it.label} ${it.hint}`.toLowerCase()}>
          <a href={it.href} tabindex="-1"><span class="kbar-label">{it.label}</span><span class="kbar-hint">{it.hint}</span></a>
        </li>
      ))}
    </ul>
    <p class="kbar-empty" data-kbar-empty hidden>{ui.empty}</p>
    <p class="kbar-foot">{ui.nav}</p>
  </div>
</dialog>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('[data-kbar]')!;
  const input = dlg.querySelector<HTMLInputElement>('[data-kbar-input]')!;
  const rows = Array.from(dlg.querySelectorAll<HTMLLIElement>('[data-kbar-list] li'));
  const empty = dlg.querySelector<HTMLElement>('[data-kbar-empty]')!;
  const isMac = /Mac|iPhone|iPad/.test(navigator.platform);
  document.querySelectorAll('[data-kbar-mod]').forEach((el) => (el.textContent = isMac ? '⌘' : 'Ctrl '));
  let active = 0;
  const visible = () => rows.filter((r) => !r.hidden);
  const mark = () => {
    const v = visible();
    rows.forEach((r) => r.removeAttribute('aria-selected'));
    if (!v.length) return input.removeAttribute('aria-activedescendant');
    active = Math.max(0, Math.min(active, v.length - 1));
    v[active].setAttribute('aria-selected', 'true');
    input.setAttribute('aria-activedescendant', v[active].id);
    v[active].scrollIntoView({ block: 'nearest' });
  };
  const filter = () => {
    const q = input.value.trim().toLowerCase();
    rows.forEach((r) => (r.hidden = !!q && !r.dataset.text!.includes(q)));
    empty.hidden = visible().length > 0;
    active = 0;
    mark();
  };
  const open = () => { input.value = ''; filter(); dlg.showModal(); input.focus(); };
  document.querySelectorAll('[data-kbar-open]').forEach((b) => b.addEventListener('click', open));
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); dlg.open ? dlg.close() : open(); }
  });
  input.addEventListener('input', filter);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { e.preventDefault(); active++; mark(); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); active--; mark(); }
    else if (e.key === 'Enter') { const a = visible()[active]?.querySelector('a'); if (a) { dlg.close(); a.click(); } }
  });
  rows.forEach((r) => r.addEventListener('mousemove', () => { active = visible().indexOf(r); mark(); }));
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  dlg.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => dlg.close()));
</script>

<style is:global>
  .kbar-open { position: fixed; right: 1.25rem; bottom: 1.25rem; z-index: 20; display: inline-flex; align-items: center; gap: .6rem;
    padding: .55rem .6rem .55rem .9rem; border-radius: 999px; border: 1px solid var(--line); background: var(--panel); color: var(--text2);
    font: 600 .85rem var(--f-text); cursor: pointer; }
  .kbar-open:hover { border-color: var(--muted); color: var(--text); }
  .kbar-open kbd, .kbar-foot { font: 600 .75rem var(--f-text); color: var(--muted); }
  .kbar-open kbd { border: 1px solid var(--line); border-radius: 6px; padding: .1rem .4rem; }
  .kbar { width: min(640px, calc(100% - 2rem)); padding: 0; margin: 12vh auto auto; border: 1px solid var(--line); border-radius: 14px;
    background: var(--panel); color: var(--text); box-shadow: 0 30px 80px -20px rgba(0,0,0,.6); }
  .kbar::backdrop { background: rgba(5,8,14,.6); backdrop-filter: blur(4px); }
  .kbar-input { width: 100%; padding: 1.05rem 1.2rem; border: 0; border-bottom: 1px solid var(--line); background: transparent; color: var(--text);
    font: 500 1.05rem var(--f-text); outline: none; }
  .kbar-list { list-style: none; margin: 0; padding: .4rem; max-height: 52vh; overflow: auto; }
  .kbar-list li[data-group]::before { content: attr(data-group); display: none; }
  .kbar-list a { display: flex; justify-content: space-between; gap: 1rem; padding: .6rem .8rem; border-radius: 8px; color: var(--text2); text-decoration: none; }
  .kbar-list li[aria-selected='true'] a { background: var(--line2); color: var(--text); }
  .kbar-hint { color: var(--muted); font-size: .85rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 45%; }
  .kbar-empty { margin: 0; padding: 1rem 1.2rem; color: var(--muted); }
  .kbar-foot { margin: 0; padding: .6rem 1.2rem; border-top: 1px solid var(--line); }
  @media (max-width: 640px) { .kbar-open span { display: none; } .kbar-hint { display: none; } }
</style>
