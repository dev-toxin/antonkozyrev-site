---
import '@fontsource-variable/manrope/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';
import { Image } from 'astro:assets';
import { copy, links, type Lang, type AppId } from '../content';
import AgentConsole from './AgentConsole.astro';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import antonPhoto from '../assets/anton.webp';
import artSitefarm from '../assets/art/case-sitefarm.jpg';
import artMobile from '../assets/art/case-mobile.jpg';
const caseArt: Record<string, ImageMetadata> = { sitefarm: artSitefarm, mobile: artMobile };
const helpIcons = ['smartphone', 'code', 'server', 'bot'];

import zhabbyIcon from '../assets/apps/zhabby-icon.png';
import zhabby1 from '../assets/apps/zhabby-1.jpg';
import zhabby2 from '../assets/apps/zhabby-2.jpg';
import mealhubIcon from '../assets/apps/mealhub-icon.png';
import mealhub1 from '../assets/apps/mealhub-1.jpg';
import mealhub2 from '../assets/apps/mealhub-2.jpg';
import greenfeedIcon from '../assets/apps/greenfeed-icon.png';
import greenfeed1 from '../assets/apps/greenfeed-1.jpg';
import greenfeed2 from '../assets/apps/greenfeed-2.jpg';
import gsrIcon from '../assets/apps/gsr-icon.png';
import gsr1 from '../assets/apps/gsr-1.jpg';
import gsr2 from '../assets/apps/gsr-2.jpg';
import lkIcon from '../assets/apps/lk-icon.png';
import lk1 from '../assets/apps/lk-1.jpg';
import lk2 from '../assets/apps/lk-2.jpg';
import tapreplyHome from '../assets/sites/tapreply-home.png';
import terroirHome from '../assets/sites/terroir-home.png';
import sitefarmStation from '../assets/sites/sitefarm-station.webp';

const siteShots = { tapreply: tapreplyHome, terroir: terroirHome, frost: sitefarmStation };

interface Props {
  lang: Lang;
}

const media: Record<AppId, { icon?: ImageMetadata; phones: ImageMetadata[] }> = {
  gsr: { icon: gsrIcon, phones: [gsr1, gsr2] },
  lk: { icon: lkIcon, phones: [lk1, lk2] },
  zhabby: { icon: zhabbyIcon, phones: [zhabby1, zhabby2] },
  jobline: { phones: [] },
  qworking: { phones: [] },
  mealhub: { icon: mealhubIcon, phones: [mealhub1, mealhub2] },
  greenfeed: { icon: greenfeedIcon, phones: [greenfeed1, greenfeed2] },
};

const { lang } = Astro.props;
const t = copy[lang];
const site = Astro.site ?? new URL('https://antonkozyrev.dev');
const canonical = new URL(t.path, site).href;
const altLang: Lang = lang === 'en' ? 'ru' : 'en';
const altUrl = new URL(copy[altLang].path, site).href;
const ogImage = new URL('/og.png', site).href;
const isExternal = (href: string) => href.startsWith('http');
const appsShots = t.apps.filter((a) => media[a.id].phones.length > 0);
const appsCompact = t.apps.filter((a) => media[a.id].phones.length === 0);
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': new URL('/#person', site).href,
  name: t.hero.name,
  alternateName: lang === 'en' ? 'Антон Козырев' : 'Anton Kozyrev',
  jobTitle: 'Senior Flutter Developer',
  url: canonical,
  image: ogImage,
  email: `mailto:${links.email}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: lang === 'en' ? 'Kaliningrad' : 'Калининград',
    addressCountry: 'RU',
  },
  sameAs: [links.github, links.linkedin, links.telegram, links.resume].filter(Boolean),
  knowsAbout: ['Flutter', 'Dart', 'Riverpod', 'Go', 'PostgreSQL', 'REST API', 'LLM integration'],
  knowsLanguage: ['ru', 'en'],
};
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={t.htmlLang} href={canonical} />
    <link rel="alternate" hreflang={copy[altLang].htmlLang} href={altUrl} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', site).href} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0B0F17" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'ru_RU'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.title} />
    <meta name="twitter:description" content={t.description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
  </head>
  <body id="top">
    <a class="skip" href="#main">{lang === 'en' ? 'Skip to content' : 'К содержанию'}</a>
        <header class="bar">
      <div class="wrap bar-inner">
        <a class="logo" href={t.path} aria-label={t.hero.name}><Logo /><span class="logo-name hide-s">{t.hero.name}</span></a>
        <nav aria-label={lang === 'en' ? 'Sections' : 'Разделы'}>
          <a href="#work">{t.nav.cases}</a>
          <a href="#apps" class="hide-xs">{t.nav.apps}</a>
          <a href="#help" class="hide-s">{t.help.nav}</a>
          <a href="#ai" class="hide-s">{t.nav.ai}</a>
          <a href="#stack" class="hide-s">{t.nav.stack}</a>
          <a href="#contact">{t.nav.contact}</a>
          <a class="lang" href={t.switchHref} hreflang={copy[altLang].htmlLang} lang={copy[altLang].htmlLang} title={t.switchTitle}>{t.switchLabel}</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="hero wrap">
        <div class="hero-text">
          <p class="eyebrow"><span class="dot" aria-hidden="true"></span>{t.hero.role}</p>
          <h1><span class="neon">{t.hero.name}</span></h1>
          <p class="lead">{t.hero.lead}</p>
          <ul class="meta">
            {t.hero.meta.map((m) => <li>{m}</li>)}
          </ul>
          <div class="cta">
            <a class="btn primary" href={t.hero.resumePdf} target="_blank" rel="noopener"><Icon name="file-text" />{t.hero.ctaResume}</a>
            <a class="btn" href={links.telegram} target="_blank" rel="noopener"><Icon name="send" />Telegram</a>
            <a class="btn ghost" href={t.help.clientLink.href}>{t.hero.ctaOrder} →</a>
          </div>
          <ul class="stats" aria-label={t.hero.stats.join(' · ')}>
            {t.hero.statsNum.map((m) => (
              <li><b data-count={m.n} data-dec={m.dec ?? 0} data-suffix={m.suffix}>{m.n.toLocaleString(lang === 'en' ? 'en-US' : 'ru-RU', { minimumFractionDigits: m.dec ?? 0 })}{m.suffix}</b><span>{m.label}</span></li>
            ))}
          </ul>
        </div>
        <AgentConsole c={t.console} />
      </section>

      <section id="work" class="wrap section">
        <h2><span class="num">01</span>{t.casesTitle}</h2>
        <div class="cases">
          {
            t.cases.map((c) => (
              <article class:list={['card glow case', { wide: c.wide }]} id={c.id}>
                <div class="case-head">
                  <div>
                    <p class="tag">{c.tag}</p>
                    <h3>{c.title}</h3>
                    <p class="summary">{c.summary}</p>
                  </div>
                  {caseArt[c.id] && <Image class="case-art" src={caseArt[c.id]} alt="" widths={[320, 640]} sizes="(max-width: 900px) 92vw, 600px" format="webp" loading="lazy" />}
                </div>
                <ul class="facts">
                  {c.facts.map((f) => <li>{f}</li>)}
                </ul>
                <p class="stackline">{c.stack}</p>
                <div class="case-media">
                  {c.shot && c.live && (
                    <a class="browser" href={c.live.href} target="_blank" rel="noopener" aria-label={c.live.label}>
                      <span class="browser-bar" aria-hidden="true">
                        <i></i><i></i><i></i>
                        <span class="browser-url">{c.live.href.replace('https://', '')}</span>
                      </span>
                      <Image src={siteShots[c.shot]} alt={c.title} widths={[480, 720, 960]} sizes="(max-width: 900px) 92vw, 560px" loading="lazy" format="webp" />
                    </a>
                  )}
                </div>
                <div class="case-links">
                  {c.live && (
                    <a class="chip" href={c.live.href} target="_blank" rel="noopener">{c.live.label}</a>
                  )}
                  {c.link && (
                    <a class="more" href={c.link.href} rel="noopener">
                      {c.link.label} →
                    </a>
                  )}
                </div>
                {c.liveNote && <p class="case-note">{c.liveNote}</p>}
              </article>
            ))
          }
        </div>
      </section>

      <section id="apps" class="wrap section">
        <h2><span class="num">02</span>{t.appsTitle}</h2>
        <p class="sub">{t.appsLead}</p>
        <div class="apps">
          {
            appsShots.map((a) => {
              const m = media[a.id];
              return (
                <article class="app glow">
                  <div class="shots">
                    {a.badge && <span class="badge corner">{a.badge}</span>}
                    {m.phones.map((img, i) => (
                      <div class={`phone p${i}`}>
                        <Image src={img} alt={`${a.name} — ${lang === 'en' ? 'screenshot' : 'скриншот'} ${i + 1}`} widths={[200, 300]} sizes="(max-width: 640px) 40vw, 150px" format="webp" quality={70} loading="lazy" />
                      </div>
                    ))}
                  </div>
                  <div class="app-head">
                    {m.icon ? (
                      <Image class="icon" src={m.icon} alt="" width={56} height={56} format="webp" loading="lazy" />
                    ) : (
                      <span class="icon mono" aria-hidden="true">{a.name.slice(0, 1)}</span>
                    )}
                    <div class="app-title">
                      <h3 title={a.name}>{a.name}</h3>
                      <p class="years">{a.years} · Flutter</p>
                    </div>
                  </div>
                  <p class="what">{a.what}</p>
                  <p class="role">{a.role}</p>
                  <p class="stackline">{a.stackNote ?? ''}</p>
                  <p class="app-links">
                    {a.links.map((l) => (
                      <a class="chip" href={l.href} rel="noopener">{l.label} ↗</a>
                    ))}
                  </p>
                </article>
              );
            })
          }
        </div>
        {appsCompact.length > 0 && (
          <div class="apps-more">
            {appsCompact.map((a) => (
              <article class="app compact glow">
                <span class="icon mono" aria-hidden="true">{a.name.slice(0, 1)}</span>
                <div class="compact-body">
                  <h3>{a.name}</h3>
                  <p class="years">{a.years} · Flutter</p>
                  <p>{a.what}</p>
                  <p class="role">{a.role}</p>
                  <p class="app-links">
                    {a.links.map((l) => (
                      <a class="chip" href={l.href} rel="noopener">{l.label} ↗</a>
                    ))}
                  </p>
                </div>
              </article>
            ))}
          </div>
        )}
      </section>

      <section id="help" class="wrap section">
        <h2><span class="num">03</span>{t.help.title}</h2>
        <div class="cases">
          {
            t.help.items.map((h, i) => (
              <article class="card glow">
                <span class="svc-icon" aria-hidden="true"><Icon name={helpIcons[i % helpIcons.length]} /></span>
                <h3>{h.title}</h3>
                <p>{h.text}</p>
              </article>
            ))
          }
        </div>
        <p class="sub">{t.help.format} <a href="#contact">{t.hero.ctaSecondary} →</a></p>
        <p class="sub"><a class="btn primary" href={t.help.clientLink.href}>{t.hero.ctaOrder} →</a></p>
      </section>

      <section id="ai" class="wrap section">
        <h2><span class="num">04</span>{t.aiTitle}</h2>
        <p class="sub">{t.aiLead}</p>
        <div class="tools" aria-label={t.toolsTitle}>
          <span class="tools-title">{t.toolsTitle}</span>
          <ul>
            {t.tools.map((x) => (
              <li class={x.main ? 'main' : ''}><strong>{x.name}</strong><span>{x.note}</span></li>
            ))}
          </ul>
        </div>
        <ol class="ai">
          {
            t.ai.map((a, i) => (
              <li class="glow">
                <span class="step">0{i + 1}</span>
                <h3>{a.title}</h3>
                <p>{a.text}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section id="stack" class="wrap section">
        <h2><span class="num">05</span>{t.stackTitle}</h2>
        <p class="sub">{t.stackLead}</p>
        <dl class="stack">
          {
            t.stack.map((s) => (
              <div class="row">
                <dt>{s.group}</dt>
                <dd>
                  <span>{s.items}</span>
                  <span class="where">
                    {s.where.map((w, i) => (
                      <>
                        {i > 0 && ' · '}
                        <a href={w.href} rel={isExternal(w.href) ? 'noopener' : undefined}>{w.label}</a>
                      </>
                    ))}
                  </span>
                </dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section id="about" class="wrap section">
        <div class="about">
          <Image src={antonPhoto} alt={t.about.photoAlt} width={160} height={160} format="webp" loading="lazy" />
          <div>
            <h2>{t.about.title}</h2>
            <p class="sub">{t.about.text}</p>
          </div>
        </div>
      </section>

      <section id="contact" class="wrap section">
        <div class="contact glow">
          <h2><span class="num">06</span>{t.contactTitle}</h2>
          <p class="sub">{t.contactLead}</p>
          <div class="hire">
            <a class="btn primary" href={t.hero.resumePdf} target="_blank" rel="noopener"><Icon name="file-text" />{t.hero.ctaResume}</a>
            <a class="btn" href={links.telegram} target="_blank" rel="noopener"><Icon name="send" />Telegram @tokc_a</a>
            <a class="btn" href={`mailto:${links.email}`}><Icon name="mail" />{links.email}</a>
          </div>
          <ul class="contacts">
            {
              t.contactItems.filter((c) => c.label !== 'Email' && c.label !== 'Telegram').map((c) => (
                <li>
                  <span class="label">{c.label}</span>
                  <a href={c.href} rel={isExternal(c.href) ? 'noopener' : undefined}>{c.value}</a>
                </li>
              ))
            }
            {links.resume && (
              <li>
                <span class="label">{t.resumeLabel}</span>
                <a href={links.resume} target="_blank" rel="noopener">hh.ru ↗</a>
              </li>
            )}
          </ul>
        </div>
      </section>
    </main>

    <footer class="wrap foot">
      <span>© {new Date().getFullYear()} {t.footer}</span>
      <a href={t.switchHref} hreflang={copy[altLang].htmlLang}>{t.switchTitle}</a>
    </footer>
    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const nums = Array.from(document.querySelectorAll<HTMLElement>('.stats b[data-count]'));
      if (!reduce && 'IntersectionObserver' in window && nums.length) {
        const lang = document.documentElement.lang === 'en' ? 'en-US' : 'ru-RU';
        const fmt = (el: HTMLElement, v: number) => {
          const dec = Number(el.dataset.dec ?? 0);
          el.textContent = v.toLocaleString(lang, { minimumFractionDigits: dec, maximumFractionDigits: dec }) + (el.dataset.suffix ?? '');
        };
        const io = new IntersectionObserver((entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          io.disconnect();
          // Отсчёт начинается с первого кадра: если кадры не идут (фоновая вкладка, скриншотер),
          // на странице остаются итоговые значения из HTML, а не нули.
          let t0 = -1;
          const step = (now: number) => {
            if (t0 < 0) t0 = now;
            const k = Math.min(1, (now - t0) / 800);
            const e = 1 - Math.pow(1 - k, 3);
            nums.forEach((el) => fmt(el, Number(el.dataset.count) * e));
            if (k < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
          // Страховка: если анимация не дошла до конца (вкладка в фоне, медленный кадр) — показать итоговые значения.
          setTimeout(() => nums.forEach((el) => fmt(el, Number(el.dataset.count))), 1200);
        }, { threshold: 0.4 });
        io.observe(nums[0].closest('.stats')!);
      }
    </script>
  </body>
</html>
