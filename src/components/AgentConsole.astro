---
interface Props {
  c: { title: string; approve: string; reject: string; lines: { kind: string; text: string }[] };
}
const { c } = Astro.props;
const prefix: Record<string, string> = { cmd: '›', plan: '◆', file: ' ', ask: '?', ok: '✓' };
---

<figure class="console" aria-label={c.title} data-console>
  <div class="console-bar">
    <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="console-title">{c.title}</span>
  </div>
  <ol class="console-body">
    {
      c.lines.map((l, i) => (
        <li class={`ln ${l.kind}`} style={`--i:${i}`}>
          <span class="pfx" aria-hidden="true">{prefix[l.kind]}</span>
          <span>{l.text}</span>
          {l.kind === 'ask' && (
            <span class="approval" aria-hidden="true">
              <span class="ap yes">{c.approve}</span>
              <span class="ap no">{c.reject}</span>
            </span>
          )}
        </li>
      ))
    }
    <li class="ln caret" style={`--i:${c.lines.length}`} aria-hidden="true"><span class="pfx">›</span><span class="cur"></span></li>
  </ol>
</figure>

<script>
  // Консоль печатает сценарий один раз, когда видна; курсор после — выключен.
  const box = document.querySelector<HTMLElement>('[data-console]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (box && !reduce && 'IntersectionObserver' in window) {
    const lines = Array.from(box.querySelectorAll<HTMLElement>('.ln'));
    box.classList.add('typing');
    const io = new IntersectionObserver((entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      io.disconnect();
      const per = Math.min(650, 5000 / Math.max(1, lines.length));
      lines.forEach((ln, i) => setTimeout(() => {
        ln.classList.add('on');
        if (i === lines.length - 1) box.classList.add('done');
      }, 300 + i * per));
    }, { threshold: 0.3 });
    io.observe(box);
  } else if (box) {
    box.classList.add('done');
  }
</script>
