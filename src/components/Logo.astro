---
// Знак личного бренда «AK» — ровно форма референса mark-ak (Alice AI ART, 2026-10-28),
// перекрашенная в акцент палитры #4C6FFF, фон прозрачный. PNG: 1x не нужен — шапка 32 px,
// поэтому базовый файл 64 px (retina 2x) и 96 px для 3x.
interface Props { height?: number }
const { height = 32 } = Astro.props;
const width = Math.round((97 / 64) * height);
---
<img class="mark" src="/logo-ak.png" srcset="/logo-ak.png 2x, /logo-ak@3x.png 3x" width={width} height={height} alt="" decoding="async" />
